{
  "name": "webm-to-mp4",
  "productName": "WebM to MP4",
  "version": "1.0.0",
  "description": "Chuyển nhiều file WebM sang MP4 trên Windows",
  "main": "src/main.js",
  "author": "Concrete Corp",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node scripts/test-convert.js",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac dmg"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.concrete.webm2mp4",
    "productName": "WebM to MP4",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "include": "build/installer.nsh",
      "shortcutName": "WebM to MP4"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
